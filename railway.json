{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci && npx turbo run build --filter=@rae/api"
  },
  "deploy": {
    "startCommand": "npm run start -w @rae/api",
    "preDeployCommand": ["npm run db:migrate:deploy -w @rae/api"],
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120
  }
}
