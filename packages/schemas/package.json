{
  "name": "@rae/schemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@rae/domain": "0.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@rae/config": "0.0.0",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
