# Postgres. Required. Matches docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rent_at_ease

# Redis for the daily reminder and retention workers. Optional for a first test; workers stay off when this is empty.
REDIS_URL=redis://localhost:6379

# API listen port. Optional.
API_PORT=4000

# Browser origins allowed to call the API. Optional; these are the local defaults.
WEB_ORIGIN=http://localhost:3000
MARKETING_ORIGIN=http://localhost:3001

# Portal base URL for receipt confirm/dispute links. Optional locally.
# NEXT_PUBLIC_API_URL is read by the portal. The API also loads this file.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public API base used inside WhatsApp document links. Use an https URL in production.
# Local http links are omitted from WhatsApp document headers.
API_PUBLIC_URL=http://localhost:4000

# Session signing secrets. Required. Each must be at least 32 characters. Do not commit real values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# How sign-in codes are delivered: log, termii, infobip, or whatsapp.
# log writes the code to the API log and, outside production, returns it to the sign-in screen.
# log is refused when NODE_ENV=production.
OTP_DELIVERY=log

# Termii SMS. Required when OTP_DELIVERY=termii.
TERMII_API_KEY=
TERMII_SENDER_ID=RentAtEase
TERMII_BASE_URL=https://api.ng.termii.com

# Infobip SMS. Required when OTP_DELIVERY=infobip.
# BASE_URL is the account host from the Infobip dashboard, with or without https://.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=RentAtEase

# Email codes. Required only when signing in by email and OTP_DELIVERY is not log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp Cloud API. Optional until you send reminders or receipts.
# Without these, messages are saved as failed with a clear reason and the PDF can still be downloaded.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Meta template names (optional). Leave blank to use the rae_* defaults in apps/api/src/config/whatsapp-templates.ts.
# WHATSAPP_OTP_TEMPLATE=rae_otp
# WHATSAPP_CARETAKER_INVITE_TEMPLATE=rae_caretaker_invite
# WHATSAPP_TEMPLATE_RENT_REMINDER=rae_rent_reminder
# WHATSAPP_TEMPLATE_RENT_OVERDUE=rae_rent_overdue
# WHATSAPP_TEMPLATE_OWNER_OVERDUE=rae_owner_overdue
# WHATSAPP_TEMPLATE_RENT_RECEIPT=rae_rent_receipt
# WHATSAPP_TEMPLATE_APPLICATION_RECEIVED=rae_application_received
# WHATSAPP_TEMPLATE_APPLICATION_DECISION=rae_application_decision
# WHATSAPP_TEMPLATE_TENANT_WELCOME=rae_tenant_welcome
# Dev smoke test for caretaker only: WHATSAPP_CARETAKER_INVITE_TEMPLATE=hello_world
# WHATSAPP_TEMPLATE_LANGUAGE=en

# AES-256-GCM key for applicant ID numbers: base64 of 32 bytes.
# Required before an application stores an ID number. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# S3-compatible storage for IDs and receipt PDFs. Optional.
# When S3_BUCKET is empty, files are stored on local disk under apps/api/.data.
# If S3_BUCKET is set, the region and both keys are required.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Shared secret for POST /api/plans/activate. Optional until you move an account off Starter.
PLAN_ADMIN_SECRET=

# development allows OTP_DELIVERY=log. production refuses it and expects provider credentials.
NODE_ENV=development
