{
  "name": "@rae/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run prisma:client && nest start --watch",
    "prisma:client": "prisma generate && tsup --config tsup.prisma.config.ts && cp prisma-client/client.d.mts prisma-client/client.d.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint src prisma/seed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.prisma.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@rae/domain": "0.0.0",
    "@rae/schemas": "0.0.0",
    "bullmq": "^6.3.13",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@rae/config": "0.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.3",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsup": "8.5.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
